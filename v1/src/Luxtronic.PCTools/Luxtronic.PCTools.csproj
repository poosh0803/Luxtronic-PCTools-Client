<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Luxtronic.PCTools</RootNamespace>
    <AssemblyName>Luxtronic.PCTools</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Requires elevation because LibreHardwareMonitorLib loads the WinRing0 kernel driver for sensor access. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Kept self-contained-publish friendly: no dependency here that can't be trimmed/bundled into a single exe later. -->
    <SelfContained>false</SelfContained>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <!-- Fallback CPU temp/clock source for hardware where LHM's WinRing0-based MSR reads don't
         work (confirmed on real technician PCs - see HwInfoSensorReader.cs remarks). Pinned to
         2.1.0, not the latest (3.0.0 targets net10.0-windows only, incompatible with this net8.0
         project) - 2.1.0 multi-targets net6.0-windows;net8.0-windows. -->
    <PackageReference Include="Hwinfo.SharedMemory.Net" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
