<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Luxtronic.PCTools</RootNamespace>
    <AssemblyName>Luxtronic.PCTools</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Requires elevation because LibreHardwareMonitorLib loads the WinRing0 kernel driver for sensor access. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Kept self-contained-publish friendly: no dependency here that can't be trimmed/bundled into a single exe later. -->
    <SelfContained>false</SelfContained>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
