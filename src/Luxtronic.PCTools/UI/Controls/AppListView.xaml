<UserControl
    x:Class="Luxtronic.PCTools.UI.Controls.AppListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Luxtronic.PCTools.UI.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer behaviors:WheelScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24">
            <Grid>
                <StackPanel>
                    <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                    <ui:TextBlock
                        Margin="0,2,0,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Subtitle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ShowGridCommand}"
                        Content="Grid"
                        Icon="{ui:SymbolIcon Grid24}"
                        ToolTip="Show as a grid"
                        Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ShowListCommand}"
                        Content="List"
                        Icon="{ui:SymbolIcon TextBulletListLtr24}"
                        ToolTip="Show as a list"
                        Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ClearDownloadsCommand}"
                        Content="{Binding ClearLabel}"
                        Icon="{ui:SymbolIcon Delete24}" />
                    <ui:Button
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </StackPanel>
            </Grid>

            <ui:ProgressRing
                Width="28"
                Height="28"
                Margin="0,8"
                HorizontalAlignment="Left"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <ui:TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Message}"
                TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding Apps}" Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <Image
                                        Source="{Binding Icon}"
                                        Stretch="Uniform"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                    <ui:SymbolIcon
                                        FontSize="32"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Box24"
                                        Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontTypography="BodyStrong"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Title}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding FileText}" />
                                    <ProgressBar
                                        Height="6"
                                        Margin="0,8,16,0"
                                        Maximum="100"
                                        Value="{Binding Progress, Mode=OneWay}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <ui:TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Status}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Command="{Binding CancelCommand}"
                                        Content="Cancel"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Command="{Binding OpenFolderCommand}"
                                        Content="Folder"
                                        Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button
                                        MinWidth="104"
                                        Appearance="Primary"
                                        Command="{Binding PrimaryCommand}"
                                        Content="{Binding PrimaryLabel}"
                                        IsEnabled="{Binding HasFile}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Apps}" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Width="236" Margin="0,0,12,12">
                            <StackPanel>
                                <Grid Width="56" Height="56" Margin="0,0,0,10" HorizontalAlignment="Left">
                                    <Image
                                        Source="{Binding Icon}"
                                        Stretch="Uniform"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                    <ui:SymbolIcon
                                        FontSize="40"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Box24"
                                        Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Title}" />
                                <ui:TextBlock
                                    MaxHeight="54"
                                    Margin="0,2,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTip="{Binding Description}" />
                                <ui:TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding FileText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding FileText}" />
                                <ProgressBar
                                    Height="6"
                                    Margin="0,8,0,0"
                                    Maximum="100"
                                    Value="{Binding Progress, Mode=OneWay}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                <ui:TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Command="{Binding CancelCommand}"
                                        Content="Cancel"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Command="{Binding OpenFolderCommand}"
                                        Content="Folder"
                                        Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button
                                        MinWidth="96"
                                        Appearance="Primary"
                                        Command="{Binding PrimaryCommand}"
                                        Content="{Binding PrimaryLabel}"
                                        IsEnabled="{Binding HasFile}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
