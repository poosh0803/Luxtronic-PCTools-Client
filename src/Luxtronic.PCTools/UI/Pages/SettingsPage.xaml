<Page
    x:Class="Luxtronic.PCTools.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Luxtronic.PCTools.UI.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings">
    <ScrollViewer behaviors:WheelScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Settings" />

            <!--  Server  -->
            <ui:Card Margin="0,16,0,12">
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Server connection" />
                    <ui:TextBlock Margin="0,0,0,4" Text="Server URL" />
                    <ui:TextBox Margin="0,0,0,12" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Margin="0,0,0,4" Text="Technician API key (issued by the server)" />
                    <ui:PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,12" PasswordChanged="ApiKeyBox_PasswordChanged" />
                    <ui:ToggleSwitch
                        Margin="0,0,0,4"
                        Content="Offline mode (dev testing) - run tests without contacting the server"
                        IsChecked="{Binding OfflineMode}" />
                    <ui:TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Nothing is sent: no session, test run or telemetry reaches the server, and no results are recorded anywhere. For development only."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!--  Test setup  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Tests" />
                    <ui:TextBlock Margin="0,0,0,4" Text="Duration (minutes, 1 to 1440)" />
                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="CPU" />
                            <ui:TextBox Width="100" Text="{Binding CpuMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="GPU" />
                            <ui:TextBox Width="100" Text="{Binding GpuMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="RAM" />
                            <ui:TextBox Width="100" Text="{Binding RamMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="VRAM" />
                            <ui:TextBox Width="100" Text="{Binding VramMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <ui:TextBlock Margin="0,0,0,4" Text="CPU test load level (Prime95)" />
                    <ComboBox
                        MinWidth="420"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding LoadLevels}"
                        SelectedValue="{Binding CpuLoad}"
                        SelectedValuePath="Level" />

                    <ui:ToggleSwitch
                        Margin="0,0,0,16"
                        Content="Run Prime95 and TestMem5 in the background (hide their windows during the CPU and RAM tests)"
                        IsChecked="{Binding HideTools}" />

                    <ui:TextBlock Margin="0,0,0,4" Text="VRAM test GPU number (memtest_vulkan's list: 1 = first, 0 = auto)" />
                    <ui:TextBox
                        Width="100"
                        HorizontalAlignment="Left"
                        Text="{Binding VramDevice, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ui:Card>

            <!--  Telemetry  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Telemetry" />
                    <ui:TextBlock Margin="0,0,0,4" Text="Sampling interval (ms, 100 to 10000) - how often sensors are sampled and sent during a test" />
                    <ui:TextBox
                        Width="160"
                        HorizontalAlignment="Left"
                        Text="{Binding TelemetryInterval, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ui:Card>

            <!--  Appearance  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Appearance" />
                    <ComboBox
                        Width="200"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Themes}"
                        SelectedItem="{Binding SelectedTheme}" />
                </StackPanel>
            </ui:Card>

            <!--  Save actions: apply to everything above  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding SaveCommand}"
                            Content="Save"
                            Icon="{ui:SymbolIcon Save24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding TestConnectionCommand}"
                            Content="Save and test connection"
                            Icon="{ui:SymbolIcon PlugConnected24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ResetDefaultsCommand}"
                            Content="Reset to defaults"
                            Icon="{ui:SymbolIcon ArrowReset24}" />
                    </StackPanel>
                    <ui:TextBlock
                        Margin="0,8,0,0"
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap">
                        <ui:TextBlock.Style>
                            <Style TargetType="ui:TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#E5484D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBlock.Style>
                    </ui:TextBlock>
                </StackPanel>
            </ui:Card>

            <!--  Danger zone  -->
            <ui:Card Margin="0,0,0,12" BorderBrush="#E5484D" BorderThickness="1">
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,4" FontTypography="Subtitle" Foreground="#E5484D" Text="Reset everything" />
                    <ui:TextBlock
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Deletes the app's whole saved-data folder (settings including the API key, logs and the unpacked test tools) and restarts the app as if freshly installed. You will have to enter the API key again."
                        TextWrapping="Wrap" />
                    <ui:Button
                        HorizontalAlignment="Left"
                        Appearance="Danger"
                        Command="{Binding ResetEverythingCommand}"
                        Content="Reset everything and restart"
                        Icon="{ui:SymbolIcon Delete24}" />
                </StackPanel>
            </ui:Card>

            <!--  Locations  -->
            <ui:Card>
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,2" FontTypography="Subtitle" Text="Locations" />
                    <ui:TextBlock
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="The test tools are bundled inside this exe and unpacked here on first run."
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <ui:TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
