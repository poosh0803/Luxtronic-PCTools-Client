<Page
    x:Class="Luxtronic.PCTools.UI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Luxtronic.PCTools.UI.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Dashboard">
    <ScrollViewer behaviors:WheelScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Dashboard" />
            <ui:TextBlock
                Margin="0,2,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="This PC's identity and live sensors. Results are reviewed on the server dashboard, never here." />

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Status" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="1" Margin="0,2" FontWeight="SemiBold" Text="Sensor status" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Machine.SensorStatus}" TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="2" Margin="0,2" FontWeight="SemiBold" Text="Server" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding ServerUrl}" />
                        <ui:TextBlock Grid.Row="3" Margin="0,2" FontWeight="SemiBold" Text="API key" />
                        <ui:TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding ApiKeyStatus}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:Card Grid.Row="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Subtitle" Text="CPU" />
                            <ui:TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Bottom"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Machine.CpuName}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Machine.CpuStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,8,8"
                                        Padding="12,10"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <StackPanel>
                                            <ui:TextBlock
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Value}" />
                                            <ui:TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Label}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Subtitle" Text="GPU" />
                            <ui:TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Bottom"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Machine.GpuName}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Machine.GpuStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,8,8"
                                        Padding="12,10"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <StackPanel>
                                            <ui:TextBlock
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Value}" />
                                            <ui:TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Label}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ui:Card Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <ui:TextBlock FontTypography="Subtitle" Text="Motherboard" />
                        <ui:TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Bottom"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Machine.MotherboardName}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Margin="0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Serial number" />
                        <ui:TextBlock Grid.Column="1" Margin="0,2" Text="{Binding Machine.MoboSerial}" TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1" Margin="0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="BIOS version" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Machine.BiosVersion}" TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="2" Margin="0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="BIOS date" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding Machine.BiosDate}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Margin="0,4,0,8" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Storage (S.M.A.R.T.)" />
            <ui:TextBlock
                Margin="0,0,0,8"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Machine.SsdStatus}"
                TextWrapping="Wrap" />
            <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Machine.Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,12,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Model}" TextWrapping="Wrap" />
                                        <ui:TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Bus}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Padding="10,3"
                                        VerticalAlignment="Top"
                                        CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Good">
                                                        <Setter Property="Background" Value="#2E9E4F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Background" Value="#C98A00" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Bad">
                                                        <Setter Property="Background" Value="#D13438" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="SemiBold" Foreground="White" Text="{Binding HealthText}" />
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBlock
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Label}" />
                                                <ui:TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Bundled test tools" />
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,8,0" Symbol="CheckmarkCircle24">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="#E5484D" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Found}" Value="True">
                                                        <Setter Property="Foreground" Value="#3FB950" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <ui:TextBlock Text="{Binding Display}" ToolTip="{Binding Path}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
