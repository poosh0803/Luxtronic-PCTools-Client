<ui:FluentWindow
    x:Class="Luxtronic.PCTools.UI.Windows.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Welcome to Luxtronic PCTools"
    Width="520"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Welcome to Luxtronic PCTools"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="32,12,32,28">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Server connection" />
            <ui:TextBlock
                Margin="0,4,0,20"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Connect this PC to the Luxtronic server and pick a theme. You can change these later in Settings."
                TextWrapping="Wrap" />

            <ui:TextBlock Margin="0,0,0,4" Text="Server URL" />
            <ui:TextBox x:Name="ServerUrlBox" Margin="0,0,0,12" />

            <ui:TextBlock Margin="0,0,0,4" Text="Technician API key (issued by the server)" />
            <ui:PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,12" />

            <ui:ToggleSwitch
                x:Name="OfflineSwitch"
                Margin="0,0,0,4"
                Content="Offline mode (dev testing)" />
            <ui:TextBlock
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Run tests without contacting the server - nothing is sent or recorded."
                TextWrapping="Wrap" />

            <ui:TextBlock Margin="0,16,0,4" Text="Theme" />
            <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left" />

            <ui:TextBlock
                x:Name="ErrorText"
                Margin="0,12,0,0"
                Foreground="#E5484D"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Click="Skip_Click" Content="Skip for now" />
                <ui:Button
                    MinWidth="110"
                    Appearance="Primary"
                    Click="Finish_Click"
                    Content="Finish"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
