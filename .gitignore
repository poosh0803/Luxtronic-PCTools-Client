# Build output
[Bb]in/
[Oo]bj/
*.user

# Self-contained publish output (dev-menu.ps1 option 10) - large bundled-runtime binary,
# built on demand, never committed
publish/

# Real technician API key - never commit
src/Luxtronic.PCTools/apikey.txt
**/apikey.txt

# Real Prime95 binary/config - third-party, not redistributed via this repo
tools/prime95/*.exe
tools/prime95/*.dll
tools/prime95/prime.txt
tools/prime95/local.txt
tools/prime95/results.txt
!tools/prime95/README.md

# Real HWiNFO64 binary - third-party, not redistributed via this repo (optional CPU temp/clock
# fallback for hardware where LHM's own reads don't work - see README "Known risk")
tools/hwi/*.exe

# Real FurMark 2 install - third-party, not redistributed via this repo (EULA.txt: "free for any
# use", but "cannot be sold or rented" and "may not alter" - bundling the unmodified folder is a
# human decision, same as Prime95/HWiNFO - not committed piecemeal). Whole folder ignored except
# a placeholder README, same pattern as tools/prime95/.
tools/FurMark_win64/*
!tools/FurMark_win64/README.md

# Visual Studio / Rider
.vs/
.idea/
*.suo

# OS cruft
Thumbs.db
.DS_Store
